---
layout: base.njk
---
<section class="article-hero">
  <div class="container">
    <div class="breadcrumb"><a href="/">Início</a> / <a href="/blog/">Blog</a> / {{ titulo }}</div>
    <div class="article-meta">
      <span class="cat">{{ categoria }}</span>
      <span>{{ data | dataLonga }}</span>
      <span>· {{ tempoLeitura }} de leitura</span>
    </div>
    <h1>{{ titulo }}</h1>
    <div class="article-cover">
      <img src="{{ imagemCapa }}" alt="{{ titulo }}" style="width:100%;display:block">
    </div>
  </div>
</section>

<article class="article-body">
  {{ content | safe }}

  <div class="article-share">
    <span>Compartilhar:</span>
    <a href="#" class="share-btn" aria-label="Compartilhar no WhatsApp"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 2a10 10 0 00-8.5 15.2L2 22l4.9-1.4A10 10 0 1012 2z" stroke="currentColor" stroke-width="1.8"/></svg></a>
    <a href="#" class="share-btn" aria-label="Compartilhar no Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 9h3V5h-3a4 4 0 00-4 4v2H8v4h2v6h4v-6h3l1-4h-4V9a1 1 0 011-1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></a>
    <a href="#" class="share-btn" aria-label="Compartilhar por e-mail"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 6l9 7 9-7" stroke="currentColor" stroke-width="1.8"/></svg></a>
  </div>
</article>

{% if produtosRelacionados %}
<section class="section related-products">
  <div class="container">
    <div class="section-head">
      <div><h2>Você também pode gostar</h2><p>Produtos relacionados a este artigo.</p></div>
    </div>
    <div class="products-grid">
      {% for slug in produtosRelacionados %}
        {% set p = collections.produtos | selectattr("fileSlug", "equalto", slug) | first %}
        {% if p %}{% include "card-produto.njk" %}{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <div><h2>Continue lendo</h2><p>Mais artigos que podem te interessar.</p></div>
    </div>
    <div class="blog-grid">
      {% set outros = collections.blog | rejectattr("data.titulo", "equalto", titulo) | reverse | slice(0, 3) %}
      {% for post in outros %}
        {% include "card-post.njk" %}
      {% endfor %}
    </div>
  </div>
</section>
