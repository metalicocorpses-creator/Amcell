---
layout: base.njk
---
<section class="page-hero" style="padding-bottom:0">
  <div class="container">
    <div class="breadcrumb"><a href="/">Início</a> / <a href="/produtos/">Produtos</a> / {{ nome }}</div>
  </div>
</section>

<section class="product-detail">
  <div class="container">
    <div class="pd-grid">

      <div class="pd-gallery">
        <div class="pd-main-media" id="pd-main">
          <img src="{{ imagemPrincipal }}" alt="{{ nome }}" style="width:100%;height:100%;object-fit:cover">
        </div>
        {% if imagens.length > 1 %}
        <div class="pd-thumbs">
          {% for img in imagens %}
          <div class="pd-thumb {% if loop.first %}active{% endif %}" data-img="{{ img }}">
            <img src="{{ img }}" alt="" style="width:100%;height:100%;object-fit:cover">
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <div class="pd-info">
        <span class="product-cat">{{ (categorias | selectattr("slug", "equalto", categoria) | first).nome }}</span>
        <h1>{{ nome }}</h1>
        <div class="pd-rating"><span class="stars">★★★★★</span> {{ avaliacaoNota }} de 5 · {{ avaliacaoQtd }} avaliações</div>

        <div class="pd-price-block">
          <b>R$ {{ preco | preco }}</b>
          {% if precoAntigo %}<s>R$ {{ precoAntigo | preco }}</s>{% endif %}
        </div>

        <div class="pd-desc">{{ content | safe }}</div>

        {% if caracteristicas %}
        <ul class="pd-features">
          {% for item in caracteristicas %}
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg> {{ item }}</li>
          {% endfor %}
        </ul>
        {% endif %}

        <div class="pd-actions">
          <a href="{{ nome | linkWhatsapp(loja.whatsapp) }}" target="_blank" rel="noopener" class="btn btn-whatsapp">Comprar pelo WhatsApp</a>
          <a href="/produtos/" class="btn btn-outline">Ver outros produtos</a>
        </div>

        <div class="pd-meta-box">
          <span><strong>Envio:</strong> processamos em até 24h úteis para todo o Brasil.</span>
          <span><strong>Garantia:</strong> 90 dias contra defeitos de fabricação.</span>
          <span><strong>Pagamento:</strong> combinado diretamente pelo WhatsApp na finalização da compra.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <div><h2>Você também pode gostar</h2><p>Outros acessórios que combinam com este produto.</p></div>
    </div>
    <div class="products-grid">
      {% set relacionados = collections.produtos | rejectattr("data.nome", "equalto", nome) | slice(0, 4) %}
      {% for item in relacionados %}
        {% set p = item %}
        {% include "card-produto.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.pd-thumb').forEach(function(thumb){
    thumb.addEventListener('click', function(){
      document.querySelectorAll('.pd-thumb').forEach(function(t){ t.classList.remove('active'); });
      thumb.classList.add('active');
      document.querySelector('#pd-main img').src = thumb.getAttribute('data-img');
    });
  });
</script>
