<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <div class="footer-logo">
          <span class="logo-mark"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="7" y="2" width="10" height="20" rx="3" stroke="currentColor" stroke-width="2"/><line x1="10" y1="19" x2="14" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
          {{ loja.nome }}
        </div>
        <p>{{ loja.descricaoCurta }}</p>
        <div class="footer-social">
          {% if loja.instagramUrl %}<a href="{{ loja.instagramUrl }}" target="_blank" rel="noopener" aria-label="Instagram"><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg></a>{% endif %}
          <a href="https://wa.me/{{ loja.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M12 2a10 10 0 00-8.5 15.2L2 22l4.9-1.4A10 10 0 1012 2z" stroke="currentColor" stroke-width="1.6"/></svg></a>
          {% if loja.facebookUrl %}<a href="{{ loja.facebookUrl }}" target="_blank" rel="noopener" aria-label="Facebook"><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M14 9h3V5h-3a4 4 0 00-4 4v2H8v4h2v6h4v-6h3l1-4h-4V9a1 1 0 011-1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></a>{% endif %}
        </div>
      </div>
      <div class="footer-col">
        <h4>Links rápidos</h4>
        <ul>
          <li><a href="/">Início</a></li>
          <li><a href="/produtos/">Produtos</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/sobre/">Sobre nós</a></li>
          <li><a href="/contato/">Contato</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Categorias</h4>
        <ul>
          {% for cat in categorias | slice(0, 5) %}
          <li><a href="/produtos/?cat={{ cat.slug }}">{{ cat.nome }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="footer-col">
        <h4>Contato</h4>
        <ul>
          <li>WhatsApp: {{ loja.whatsapp }}</li>
          <li>{{ loja.email }}</li>
          <li>{{ loja.horario }}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <span class="current-year"></span> {{ loja.nome }}. Todos os direitos reservados.</span>
      <span>Feito com dedicação para quem ama tecnologia.</span>
    </div>
  </div>
</footer>

<a href="https://wa.me/{{ loja.whatsapp }}" target="_blank" rel="noopener" class="wa-float" aria-label="Fale conosco no WhatsApp">
  <svg viewBox="0 0 24 24" fill="none"><path d="M12 2a10 10 0 00-8.5 15.2L2 22l4.9-1.4A10 10 0 1012 2z" fill="#fff"/></svg>
</a>

<script src="/js/main.js"></script>
