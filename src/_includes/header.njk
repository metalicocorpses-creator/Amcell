<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-mark"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="7" y="2" width="10" height="20" rx="3" stroke="currentColor" stroke-width="2"/><line x1="10" y1="19" x2="14" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
      Am<span>Cell</span>
    </a>
    <nav class="main-nav">
      <a href="/" {% if page.url == '/' %}class="active"{% endif %}>Início</a>
      <a href="/produtos/" {% if '/produtos/' in page.url %}class="active"{% endif %}>Produtos</a>
      <a href="/blog/" {% if '/blog/' in page.url %}class="active"{% endif %}>Blog</a>
      <a href="/sobre/" {% if '/sobre/' in page.url %}class="active"{% endif %}>Sobre nós</a>
      <a href="/contato/" {% if '/contato/' in page.url %}class="active"{% endif %}>Contato</a>
    </nav>
    <div class="header-actions">
      <button class="search-toggle" aria-label="Buscar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
      <button class="menu-toggle" aria-label="Abrir menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="3" y1="18" x2="21" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
    </div>
  </div>
  <div class="search-panel">
    <div class="container">
      <form action="/busca/" method="get">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="flex-shrink:0;color:#565D6D"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="search" name="q" placeholder="Buscar produtos ou artigos do blog...">
        <button type="submit" class="btn btn-primary btn-sm">Buscar</button>
      </form>
    </div>
  </div>
</header>
<div class="nav-overlay"></div>
