<a href="{{ post.url }}" class="blog-card">
  <div class="blog-media">
    <img src="{{ post.data.imagemCapa }}" alt="{{ post.data.titulo }}" style="width:100%;height:100%;object-fit:cover">
  </div>
  <div class="blog-body">
    <div class="blog-meta"><span class="cat">{{ post.data.categoria }}</span><span>{{ post.data.data | dataCurta }}</span></div>
    <h3>{{ post.data.titulo }}</h3>
    <p class="blog-excerpt">{{ post.data.resumo }}</p>
    <span class="blog-readmore">Ler mais →</span>
  </div>
</a>
